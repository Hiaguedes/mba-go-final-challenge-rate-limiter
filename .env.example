SERVER_PORT=8080
# Configs do token (único token aceito no header API_KEY)
API_TOKEN=token_de_acesso
API_TOKEN_REQS_PER_SEC_LIMITTER=100

# configs do ip
IP_REQS_PER_SEC_LIMITTER=10

# config de tempo de bloqueio (em segundos)
REQS_BLOCK_TIME_SEC=300

# true apenas se a aplicação estiver atrás de um proxy que sobrescreve X-Forwarded-For
TRUST_PROXY_HEADERS=false

# configs do redis
REDIS_ADDR=redis:6379
